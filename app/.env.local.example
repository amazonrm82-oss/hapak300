# ═══════════════════════════════════════════════════════════════════════════
#  משתני הסביבה של המערכת.
#
#  בפרסום ב-Vercel מזינים אותם ב-Settings → Environment Variables (בדפדפן).
#  את הקובץ הזה צריך רק מי שמריץ את המערכת מקומית על המחשב שלו.
# ═══════════════════════════════════════════════════════════════════════════

# ── חובה: מ-Supabase → Project Settings → API ─────────────────────────────

# "Project URL"
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# המפתח "anon public" — מיועד לדפדפן, אין בו סיכון
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# ⚠️ המפתח "service_role" — סוד. נשאר בשרת בלבד, לעולם לא בדפדפן ולא בצ׳אט.
# שים לב שאין לו קידומת NEXT_PUBLIC_ — זה מה שמונע מ-Next.js לארוז אותו ללקוח.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...


# ── חובה: סודות הכניסה ────────────────────────────────────────────────────
# שתי מחרוזות אקראיות ארוכות ושונות זו מזו (40+ תווים כל אחת).

# מגן על קודי הכניסה אם מישהו משיג עותק של בסיס הנתונים.
# ⚠️ אחרי שלוחמים בחרו קודים — לעולם אל תשנה. שינוי מבטל את כל הקודים.
PIN_PEPPER=

# ממנו נגזרת סיסמת המשתמש בשרת. הקוד עצמו לעולם לא משמש כסיסמה.
AUTH_DERIVE_SECRET=


# ── חובה לתזכורות: הסיסמה שהמתזמן שולח כדי להוכיח שהוא המתזמן ─────────────
# אותה מחרוזת בדיוק נכנסת גם לפקודת ה-cron ב-Supabase.
CRON_SECRET=


# ── רשות: התראות פוש לטלפון ───────────────────────────────────────────────
# אם השדות האלה ריקים — ההתראות בתוך האפליקציה עובדות כרגיל, פשוט בלי פוש.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@hapak300.local
