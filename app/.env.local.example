# ── Supabase (מהדשבורד: Project Settings → API) ────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# ── Web Push (הרץ: npx web-push generate-vapid-keys) ───────────────────────
NEXT_PUBLIC_VAPID_PUBLIC_KEY=BEl...
VAPID_PRIVATE_KEY=...
VAPID_SUBJECT=mailto:admin@hapak300.local

# ══════════════════════════════════════════════════════════════════════════
# הסודות הבאים נשמרים ב-Supabase בלבד (Edge Functions → Secrets),
# לא כאן ולא בקוד:
#   SUPABASE_SERVICE_ROLE_KEY  — מפתח השירות של הפרויקט
#   PIN_PEPPER                 — מחרוזת אקראית ארוכה (openssl rand -base64 48)
#   AUTH_DERIVE_SECRET         — מחרוזת אקראית ארוכה נוספת
#   SITE_URL                   — כתובת האתר, ל-CORS
# ══════════════════════════════════════════════════════════════════════════
